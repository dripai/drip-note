{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "sql:allow-close",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-open",
    "fs:allow-create",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-mkdir",
    { "identifier": "fs:scope", "allow": [
      { "path": "$APPDATA/drip-note/*" },
      { "path": "$APPDATA/drip-note/**" },
      { "path": "$HOME/*" },
      { "path": "$HOME/**" },
      { "path": "$DOCUMENT/*" },
      { "path": "$DOCUMENT/**" },
      { "path": "$DESKTOP/*" },
      { "path": "$DESKTOP/**" },
      { "path": "$DOWNLOAD/*" },
      { "path": "$DOWNLOAD/**" },
      { "path": "$PICTURE/*" },
      { "path": "$PICTURE/**" },
      { "path": "$PUBLIC/*" },
      { "path": "$PUBLIC/**" },
      { "path": "$DATA/*" },
      { "path": "$DATA/**" },
      { "path": "$LOCALDATA/*" },
      { "path": "$LOCALDATA/**" }
    ] }
  ]
}
